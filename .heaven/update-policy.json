{
  "schema": "heaven-toolbox/update-policy/v1",
  "repository": "fengie/Heaven.gg",
  "branch": "main",
  "kind": "product",
  "source_update": {
    "required": true,
    "strategy": "ff-only",
    "poll_interval_minutes": 1,
    "controller": "heaven-toolbox/repo-autoupdate"
  },
  "runtime_update": {
    "mode": "self-update-release",
    "evidence_paths": [
      ".github/workflows/site.yml",
      "web/DEPLOYMENT.md",
      "web/tests/site.test.mjs"
    ]
  }
}
